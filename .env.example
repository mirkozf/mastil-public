# Copiar a .env y completar. El .env NUNCA se versiona.
#
#   cp .env.example .env && chmod 600 .env
#
# Para un ambiente de desarrollo: copiá la carpeta entera, cambiá
# MASTIL_TELEGRAM_BOT_TOKEN por el de un bot nuevo, dejá MASTIL_LITE_USERS
# vacío y NO completes las variables de Calendar. Con eso no puede tocar ni el
# calendario real ni a la usuaria asistida.

# --- imprescindibles ------------------------------------------------------
MASTIL_TELEGRAM_BOT_TOKEN=
MASTIL_OWNER_CHAT_ID=
MASTIL_ICAL_URL=

MASTIL_TIMEZONE=America/Santiago
MASTIL_PREFIX=**
MASTIL_ACTIVITY_PREFIX=++
MASTIL_POLL_SECONDS=5

# --- Guardian (eventos **) ------------------------------------------------
MASTIL_ANTICIPACION_ALERTA_MINUTES=2
MASTIL_INTERVALO_ARRANQUE_SECONDS=60
MASTIL_DURACION_TREGUA_MINUTES=5
MASTIL_TOLERANCIA_CHEQUEO_MINUTES=2
MASTIL_INTERVALO_RESCATE_INICIAL_SECONDS=60
MASTIL_INTERVALO_RESCATE_ACELERADO_SECONDS=30
MASTIL_RESCATE_ACELERA_DESPUES_MINUTES=5

# --- Pomodoro -------------------------------------------------------------
MASTIL_POMODORO_TRABAJO_MINUTES=20
MASTIL_POMODORO_DESCANSO_CORTO_SECONDS=330
MASTIL_POMODORO_DESCANSO_LARGO_MINUTES=20
MASTIL_POMODORO_TOLERANCIA_RETORNO_MINUTES=2
MASTIL_POMODORO_CICLOS=4

# --- Timer ----------------------------------------------------------------
MASTIL_TIMER_ALARMA_CADA_SECONDS=20
MASTIL_TIMER_AUTOAPAGADO_SECONDS=360
MASTIL_TIMER_BURST_GAP_SECONDS=4

# --- Mástil Lite ----------------------------------------------------------
# Formato: chat_id:Nombre:Zona  (varias separadas por coma)
#
# MODO ESPEJO: poné tu propio chat_id acá para probar el flujo completo de Lite
# sobre vos mismo, sin que la usuaria asistida participe. Recibís las dos caras a la vez: los
# mensajes que vería ella, y el aviso al propietario — que sirve para verificar
# que ese aviso nunca incluye el texto del recordatorio.
#
#   MASTIL_LITE_USERS=<tu_chat_id>:Prueba:America/Santiago
#
# Tus comandos siguen funcionando igual: Lite sólo se queda con "recordar ...",
# "recuerdame" y un número de 4 dígitos cuando hay una alarma tuya sonando.
#
# Para producción, la línea real es la de la usuaria asistida. Para desarrollo, dejala vacía
# o usá el modo espejo.
MASTIL_LITE_USERS=
MASTIL_LITE_ALERT_EVERY_SECONDS=30
MASTIL_LITE_MAX_ALERT_SECONDS=600

# --- Vigía (eventos ++) ---------------------------------------------------
MASTIL_VIGIA_RESCUE_EVERY_SECONDS=60
MASTIL_VIGIA_THIRD_PHOTO_PROBABILITY=0.33
MASTIL_VIGIA_MIN_PRESENCE_MESSAGES=1
MASTIL_VIGIA_MAX_PRESENCE_MESSAGES=3
MASTIL_VIGIA_CODE_DIGITS=4
MASTIL_VIGIA_DEFAULT_DURATION_MINUTES=20

# Sin esta clave, Vigía acepta toda foto sin evaluarla.
MASTIL_GEMINI_API_KEY=
MASTIL_GEMINI_MODEL=gemini-3.5-flash

# --- Calendar: ESCRITURA --------------------------------------------------
# Vacías = el puente queda inerte y Mástil no puede modificar el calendario.
# Es el interruptor de seguridad. Dejalas vacías salvo que sepas por qué no.
MASTIL_CALENDAR_WEBAPP_URL=
MASTIL_CALENDAR_TOKEN=
MASTIL_CALENDAR_ID=primary

# --- Gmail ----------------------------------------------------------------
MASTIL_GMAIL_WEBAPP_URL=
MASTIL_GMAIL_TOKEN=
